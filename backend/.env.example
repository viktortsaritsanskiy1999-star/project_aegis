# Project Aegis Private Local Backend Environment
AEGIS_ENV=development
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8080
AEGIS_LOG_LEVEL=info

# SQLite Database URL (stored locally in backend directory)
AEGIS_DATABASE_URL=sqlite:///./aegis_private_vault.db

# Device Pairing & API Security Secret (never commit real tokens!)
AEGIS_API_SECRET=your_secure_device_pairing_secret_here

# Google Gemini API Key (Server-Only: never exposed to client app or Git!)
GEMINI_API_KEY=your_gemini_api_key_here
